<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>quantumquest.triviathrone</groupId>
    <artifactId>triviathrone-parent</artifactId>
    <version>2.2.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>TriviaThrone Parent</name>
    <description>TriviaThrone</description>
    <url>https://github.com/QuantumQuestX/TriviaThrone</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>TiJ</name>
            <roles>
                <role>MAINTAINER</role>
                <role>CONTRIBUTOR</role>
            </roles>
            <organization>QuantumQuest</organization>
            <organizationUrl>https://github.com/QuantumQuestX</organizationUrl>
            <url>https://github.com/TiJ-code</url>
        </developer>
        <developer>
            <name>reallukeplayer</name>
            <roles>
                <role>CONTRIBUTOR</role>
            </roles>
            <organization>QuantumQuest</organization>
            <organizationUrl>https://github.com/QuantumQuestX</organizationUrl>
            <url>https://github.com/reallukeplayer</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/QuantumQuestX/TriviaThrone.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/QuantumQuestX/TriviaThrone.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/QuantumQuestX/TriviaThrone</url>
    </scm>

    <modules>
        <module>triviathrone-api</module>
        <module>triviathrone-mod-system</module>
        <module>triviathrone-client</module>
        <module>triviathrone-server</module>
        <module>triviathrone-application</module>
    </modules>

    <properties>
        <java.version>25</java.version>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <doclint>none</doclint>
                    <failOnWarnings>false</failOnWarnings>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>14.4.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>check-production-code-style</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
