<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>quantumquest.triviathrone</groupId>
    <artifactId>triviathrone-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>TriviaThrone Parent</name>
    <description>TriviaThrone</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer>
            <name>TiJ</name>
            <roles>
                <role>MAINTAINER</role>
                <role>CONTRIBUTOR</role>
            </roles>
            <organization>QuantumQuest</organization>
            <organizationUrl>https://github.com/QuantumQuestX</organizationUrl>
            <url>https://github.com/TiJ-code</url>
        </developer>
        <developer>
            <name>reallukeplayer</name>
            <roles>
                <role>CONTRIBUTOR</role>
            </roles>
            <organization>QuantumQuest</organization>
            <organizationUrl>https://github.com/QuantumQuestX</organizationUrl>
            <url>https://github.com/reallukeplayer</url>
        </developer>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>

    <modules>
        <module>api</module>
        <module>mod-system</module>
        <module>client</module>
        <module>infrastructure</module>
        <module>games</module>
        <module>server</module>
        <module>application</module>
    </modules>

    <properties>
        <java.version>25</java.version>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
