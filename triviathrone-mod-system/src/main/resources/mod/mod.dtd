<?xml version="1.0" encoding="utf-8"?>
<!ELEMENT mod (name, version, apiVersion, (apiCompatibility | apiCompatability)?, description, providers)>
<!ATTLIST mod id CDATA #REQUIRED>

<!ELEMENT plugin (name, version, apiVersion, description, providers)>
<!ATTLIST plugin id CDATA #REQUIRED>

<!ELEMENT name (#PCDATA)>
<!ELEMENT version (#PCDATA)>
<!ELEMENT apiVersion (#PCDATA)>
<!ELEMENT description (#PCDATA)>

<!ELEMENT apiCompatibility EMPTY>
<!ATTLIST apiCompatibility
    minimum CDATA #REQUIRED
    maximumExclusive CDATA #REQUIRED>
<!ELEMENT apiCompatability EMPTY>
<!ATTLIST apiCompatability
    minimum CDATA #REQUIRED
    maximumExclusive CDATA #REQUIRED>

<!ELEMENT providers (provider+)>
<!ELEMENT provider EMPTY>

<!ATTLIST provider class CDATA #REQUIRED>
