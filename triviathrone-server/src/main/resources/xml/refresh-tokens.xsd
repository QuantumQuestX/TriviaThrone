<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="refreshSessions">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="session" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:attribute name="tokenDigest" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:pattern value="[A-Za-z0-9_-]+"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                        <xs:attribute name="username" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:minLength value="1"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                        <xs:attribute name="expiresAtEpochSecond" type="xs:long" use="required"/>
                        <xs:attribute name="absoluteExpiryEpochSecond" type="xs:long" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
